{
	auto_https off
	admin off
}

:{$PORT:8080} {
	encode gzip

	handle /healthz {
		respond "ok" 200
	}

	redir /analog /analog/ 308
	redir /handwriting /handwriting/ 308
	redir /dogfight /dogfight/ 308

	handle_path /analog/* {
		reverse_proxy {$ANALOG_UPSTREAM:analog-chi3-lab:8080}
	}

	handle_path /handwriting/* {
		reverse_proxy {$HANDWRITING_UPSTREAM:handwriting-ai-lab:8081}
	}

	handle_path /dogfight/* {
		reverse_proxy {$DOGFIGHT_UPSTREAM:dogfight-ai-lab:8082}
	}

	handle {
		root * /srv
		file_server
	}
}
